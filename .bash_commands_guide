# Git
git diff --stat HEAD  :: show changed files since last commit
git reset --soft HEAD~1  :: undo last commit, keep changes staged
git commit --amend  :: change commit message
git commit --amend --no-edit  :: amend with same message
::
# Text
grep -rn "pattern" .  :: search across files
sed -i 's/pattern/replacement/g' file.txt  :: replace file contents
grep -rl 'pattern' . | xargs sed -i 's/pattern/replacement/g'  :: replace across files
::
# Files
find . -name pattern  :: search file by name
frename pattern replacement .  :: rename files & dirs
du -sh * | sort -h  :: show dir sizes sorted
tar -czf archive.tar.gz  :: create compressed archive
tar -xzf  :: extract compressed archive
::
# Process
ps aux | grep name  :: find process by name
pgrep -af name  :: find processe by name, with full command line
htop -u $USER  :: show only your processes
lsof -i :8080  :: find what process is using a port
kill -9  :: force kill process by PID
free -h  :: RAM/swap summary
df -h  :: disk space
ps -eo pid,%cpu,%mem,comm --sort=-%cpu | head  :: top CPU users
ps -eo pid,%mem,rss,comm --sort=-%mem | head  :: top memory users (rss is in KB)
::
# Network
ip a  :: ip addr details
hostname -I  :: active local IP addresses
ss -tlnp  :: show listening ports
curl -I  :: show HTTP response headers only
::
# SSH
scp /path/to/something destusername@dest-ip:/download/path/  :: send to another machine
ssh-copy-id user@host  :: copy ssh key to remote machine
