[init]
	defaultBranch = main
[user]
	email = alan.joseph@hatio.in
	name = Alan Joseph
[core]
	autocrlf = input
	editor = nano
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = false
	line-numbers = true
	hyperlinks = true
	dark = true
	hunk-header-style = omit

[alias]
    # A beautiful, readable, colorized git log tree
    lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %s %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all

    # One-off side-by-side diff via delta
    ds = -c delta.side-by-side=true diff

    # Commit with a quote-less, multi word message: git cm multi word msg
    cm = "!f() { git commit -m \"$*\"; }; f"
    
[credential]
	helper = store
